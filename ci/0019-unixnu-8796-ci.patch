++#define ALPHA_PROBE_AT_VM_INIT          6       /* arm_init.c: after arm_vm_init */
++#define ALPHA_PROBE_AT_KVA_CHECK        7       /* start.s: before ret, translate arm_init's KVA with AT S1E1R */
++#define ALPHA_PROBE_AT_SERIAL_INIT      8       /* arm_init.c: after serial_init */
++#define ALPHA_PROBE_AT_KPRINTF          9       /* arm_init.c: after kernel_startup_initialize_upto(KPRINTF) */
++#define ALPHA_PROBE_AT_PRINTF           10      /* arm_init.c: after PE_init_printf(FALSE) */
++#define ALPHA_PROBE_AT_MACHINE_STARTUP  11      /* arm_init.c: just before machine_startup */
