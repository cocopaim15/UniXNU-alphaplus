++/*
++ * alphaplus RAM log ring.
++ *
++ * There is no serial console on this board and the video console is attached
++ * late, so every kprintf line is appended here as well. The ring is a
++ * file-backed global: the non-zero initialiser keeps it out of __BSS, which
++ * means "ALPHALOG" sits inside the kernel image and DarwinBoot can find the
++ * buffer by scanning the image it just copied.
++ *
++ *   offset 0: magic "ALPHALOG"
++ *   offset 8: uint32 head (next write position, never wrapped by the reader)
++ *   offset 12: uint32 size
++ *   offset 16: data[size]
++ */
++#define ALPHA_LOG_RING_SIZE     (64 * 1024)
++
++typedef struct {
++	char             magic[8];
++	volatile uint32_t head;
++	uint32_t         size;
++	char             data[ALPHA_LOG_RING_SIZE];
++} alphaplus_log_ring_t;
++
++alphaplus_log_ring_t alphaplus_log_ring = {
++	"ALPHALOG", 0, ALPHA_LOG_RING_SIZE
++};
++
++void
++alphaplus_log_write(const char *str, int size)
++{
++	int i;
++
++	for (i = 0; i < size; i++) {
++		uint32_t at = alphaplus_log_ring.head;
++		if (at >= ALPHA_LOG_RING_SIZE) {
++			at = 0;
++		}
++		alphaplus_log_ring.data[at] = str[i];
++		alphaplus_log_ring.head = at + 1;
++	}
++}
